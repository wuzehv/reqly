{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "reqly",
  "version": "../package.json",
  "identifier": "com.wms.reqly",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Reqly",
        "width": 1360,
        "height": 860,
        "minWidth": 980,
        "minHeight": 680
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEU2NEREQzlBNkM1MTY5REIKUldUYmFWRnNtdHhONWlWZlc5amdJL2I3S2NxdlE0bTlBTGtwY1R4MFN4czZ0SDJxSWgraUM1OVYK",
      "endpoints": [
        "https://github.com/wuzehv/reqly/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
